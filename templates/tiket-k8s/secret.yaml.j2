# App environment, single source of truth for the k8s workload (replaces
# the old /root/tiket-app.env file both provision and CI consumed).
apiVersion: v1
kind: Secret
metadata:
  name: tiket-app-env
type: Opaque
stringData:
  DB_HOST: db.{{ lab_domain }}
  DB_NAME: "{{ tiket_db.name }}"
  DB_USER: "{{ tiket_db.user }}"
  DB_PASSWORD: "{{ tiket_db.password }}"
