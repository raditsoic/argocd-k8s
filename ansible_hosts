# Static inventory used only when provisioning from WSL (Vagrantfile points
# ansible.inventory_path here). Keys live on the WSL filesystem with 600 perms
# (see sync-keys.sh) because /mnt/c cannot store Linux file modes.
# Hosts are reached via the fixed NAT forwards on shared localhost (see
# Vagrantfile) — WSL has no route to the 192.168.56.x host-only subnet.
cp ansible_host=127.0.0.1 ansible_port=2210 ansible_user=vagrant ansible_ssh_private_key_file=~/.ssh/vagrant-lab/cp private_ip=192.168.56.10
web1 ansible_host=127.0.0.1 ansible_port=2211 ansible_user=vagrant ansible_ssh_private_key_file=~/.ssh/vagrant-lab/web1 private_ip=192.168.56.11
web2 ansible_host=127.0.0.1 ansible_port=2212 ansible_user=vagrant ansible_ssh_private_key_file=~/.ssh/vagrant-lab/web2 private_ip=192.168.56.12
db ansible_host=127.0.0.1 ansible_port=2213 ansible_user=vagrant ansible_ssh_private_key_file=~/.ssh/vagrant-lab/db private_ip=192.168.56.20

[controlplane]
cp

[webservers]
web1
web2

[dbservers]
db
